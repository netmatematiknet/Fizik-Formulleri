<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ sistem splash: ikon gizlenir, arka plan KenBurns ile aynı — çift splash hissi kalkar -->
    <style name="Theme.Giris" parent="Theme.Nurullah">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@drawable/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
