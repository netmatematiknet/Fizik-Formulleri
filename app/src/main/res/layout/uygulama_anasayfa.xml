<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/toolbar1_arkaplan_rengi"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:context=".UygulamaAnaSayfa"
    tools:ignore="HardcodedText">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@drawable/toolbar_golge" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:maxWidth="@dimen/content_max_width"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <Button
            android:id="@+id/button1"
            style="@style/Toolbar_Stil_1.Widget.App.ExtendedFloatingActionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@color/toolbar1_extended_floataction_arkaplan_rengi"
            android:contentDescription="@string/app_name"
            android:minHeight="@dimen/min_touch_target"
            android:padding="@dimen/home_button_padding"
            android:text="@string/app_name"
            android:textColor="#6b049e"
            android:textSize="@dimen/home_button_text"
            android:textStyle="bold"
            android:typeface="serif" />

        <Button
            android:id="@+id/button2"
            style="@style/Toolbar_Stil_1.Widget.App.ExtendedFloatingActionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/bg_uygulamalarimiz"
            android:contentDescription="@string/diger_programlar"
            android:minHeight="@dimen/min_touch_target"
            android:padding="@dimen/home_button_padding"
            android:text="@string/diger_programlar"
            android:textColor="#6b049e"
            android:textSize="16sp"
            android:textStyle="bold"
            android:typeface="serif" />

        <TextView
            android:id="@+id/tv_home_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#33FFFFFF"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="#1A237E"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/ad_banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:minHeight="@dimen/banner_min_height" />
</LinearLayout>
