<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="18dp"
        app:cardElevation="10dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_celebration_card"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_celebration_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito"
                    android:gravity="center"
                    android:paddingEnd="28dp"
                    android:text="@string/celebration_info_label"
                    android:textColor="#8B6914"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_celebration_close"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="end|top"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/celebration_close"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_close" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_celebration_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/nunito"
                android:gravity="center"
                android:textColor="#5C4300"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_celebration_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/nunito"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="#6B5420"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_celebration_ok"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/nunito"
                android:text="@string/celebration_default_button"
                android:textAllCaps="false"
                android:textColor="#3E2F00"
                android:textStyle="bold"
                app:backgroundTint="#E8C547"
                app:cornerRadius="24dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
