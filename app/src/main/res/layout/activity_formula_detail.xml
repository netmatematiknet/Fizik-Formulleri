<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraintlayout_4"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Toolbar Include -->
    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_layout_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/toolbar_shadow"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@drawable/toolbar_golge"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <com.mobilprogramlar.FizikFormullerim.SafeViewPager
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/tabDots"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_shadow" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabDots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/nurullah_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:tabGravity="start"
        app:tabIndicatorHeight="0dp"
        app:tabMaxWidth="48dp"
        app:tabMinWidth="28dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="4dp"
        app:tabPaddingStart="4dp"
        app:tabRippleColor="@android:color/transparent" />

    <View
        android:id="@+id/toolbar_shadow_alt"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@drawable/toolbar_golge"
        app:layout_constraintTop_toBottomOf="@id/tabDots" />

</androidx.constraintlayout.widget.ConstraintLayout>