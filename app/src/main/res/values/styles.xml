    <style name="Theme.Hilal" parent="Theme.MatematikBase">
        <item name="colorPrimary">@color/hilal_primary</item>
        <item name="colorPrimaryDark">@color/hilal_primary_dark</item>
        <item name="colorAccent">@color/hilal_accent</item>
    </style>




    <style name="CustomAlertDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:background">@android:color/holo_blue_light</item> <!-- Arka plan rengi -->
        <item name="android:textColorPrimary">@android:color/white</item> <!-- Metin rengi -->
        <item name="android:textColorSecondary">@android:color/white</item> <!-- İkincil metin rengi -->
        <item name="android:buttonBarButtonStyle">@style/DialogButton</item> <!-- Buton stili -->
    </style>

    <style name="DialogButton" parent="Widget.AppCompat.Button">
        <item name="android:textColor">@android:color/white</item> <!-- Buton metin rengi -->
        <item name="android:shadowColor">@android:color/darker_gray</item> <!-- Gölge rengi -->
        <item name="android:shadowDx">1</item> <!-- Gölge x ekseni -->
        <item name="android:shadowDy">1</item> <!-- Gölge y ekseni -->
        <item name="android:shadowRadius">1.5</item> <!-- Gölge yarıçapı -->
    </style>















