<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- <item name="android:background"> Uygulamanın arka plan rengini veya resmini tanımlar. -->
    <!-- <item name="android:fontFamily">: Uygulamada kullanılacak yazı tipi ailesini belirler. -->
    <!-- <item name="android:statusBarColor"> Durum çubuğunun rengini değiştirebilirsiniz.. -->
    <!-- <item name="android:windowNoTitle">true</item> Pencere başlığının görünüp görünmeyeceğini belirler. true veya false değeri alabilir. -->
    <!-- <item name="android:windowActionBar">true</item>: ActionBar'ın görünüp görünmeyeceğini kontrol eder. true veya false değeri alabilir.-->
    <!-- <item name="android:windowActionModeOverlay">true</item>: Bu ögeyi true olarak ayarlayarak, uygulamada bir bağlam menüsü görüntülendiğinde pencerenin üst kısmında bir örtü oluşturabilirsiniz..-->
    <!-- <item name="android:windowContentOverlay">: İçerik ve ActionBar arasında görünen görsel ayrımı tanımlar. -->
    <!-- <item name="android:itemTextAppearance">: Liste öğeleri gibi spesifik elementler için metin görünümünü belirler. -->
    <!-- <style name="Theme.Nadiye" parent="Theme.MaterialComponents.DayNight.NoActionBar"> -->

    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/fall_down</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
    </style>

    <!-- Bridge: AppCompat widget'ları Material temada doğru attr çözer.
         statusBarColor / navigationBarColor / windowFullscreen YOK —
         Play edge-to-edge uyarıları; çubuklar EdgeToEdge.enable ile yönetilir. -->
    <style name="Theme.MatematikBase" parent="Theme.MaterialComponents.DayNight.NoActionBar.Bridge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Matematik.Body1</item>
        <item name="textAppearanceCaption">@style/TextAppearance.Matematik.Caption</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.Matematik.Subtitle1</item>
    </style>

    <style name="TextAppearance.Matematik.Body1" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Matematik.Caption" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Matematik.Subtitle1" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textColor">@color/text_primary</item>
    </style>

        <style name="Theme.Nurullah" parent="Theme.MatematikBase">
        <item name="colorPrimary">@color/nurullah_primary</item>
            <item name="colorPrimaryDark">@color/nurullah_primary_dark</item>
            <item name="colorAccent">@color/nurullah_accent</item>
        </style>

    <!-- Açılış: KenBurns splash; sistem çubuğu WindowInsetsController ile gizlenir -->
    <style name="Theme.Giris" parent="Theme.Nurullah">
        <item name="android:windowBackground">@drawable/splash_bg</item>
    </style>

        <style name="Theme.Nadiye" parent="Theme.MatematikBase">
        <item name="colorPrimary">@color/nadiye_primary</item>
            <item name="colorPrimaryDark">@color/nadiye_primary_dark</item>
            <item name="colorAccent">@color/nadiye_accent</item>
        </style>

        <style name="Theme.Sude" parent="Theme.MatematikBase">
        <item name="colorPrimary">@color/sude_primary</item>
            <item name="colorPrimaryDark">@color/sude_primary_dark</item>
            <item name="colorAccent">@color/sude_accent</item>
        </style>

        <style name="Theme.Kubra" parent="Theme.MatematikBase">
        <item name="colorPrimary">@color/kubra_primary</item>
            <item name="colorPrimaryDark">@color/kubra_primary_dark</item>
            <item name="colorAccent">@color/kubra_accent</item>
        </style>

        <style name="Theme.Zeynep" parent="Theme.MatematikBase">
        <item name="colorPrimary">@color/zeynep_primary</item>
            <item name="colorPrimaryDark">@color/zeynep_primary_dark</item>
            <item name="colorAccent">@color/zeynep_accent</item>
        </style>

    <style name="Theme.Irem" parent="Theme.MatematikBase">
        <item name="colorPrimary">@color/irem_primary</item>
        <item name="colorPrimaryDark">@color/irem_primary_dark</item>
        <item name="colorAccent">@color/irem_accent</item>
    </style>

    <style name="Theme.Ilknur" parent="Theme.MatematikBase">
