    <style name="Theme.Rukiye" parent="Theme.MatematikBase">
        <item name="colorPrimary">@color/rukiye_primary</item>
        <item name="colorPrimaryDark">@color/rukiye_primary_dark</item>
        <item name="colorAccent">@color/rukiye_accent</item>
