<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reklamları yüklemek için internet erişimi sağlar. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Uygulamanın ağ durumunu kontrol etmesini sağlar, böylece reklamların uygun şekilde yüklenip gösterilebilmesi sağlanır. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Bu izin yalnızca uygulamanız bildirim gönderecekse gereklidir. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Reklam ID'sine erişim sağlar. Google reklam hizmetleri tarafından kullanılır. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true"
        android:anyDensity="true"
        android:resizeable="true" />

    <application
        android:name=".App"
        android:theme="@style/Theme.Nurullah"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/manifest_activity_splash_app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:resizeableActivity="true"
        tools:replace="android:allowBackup, android:label, android:roundIcon, android:supportsRtl">

        <!-- Uygulamanızın bir Ad Manager uygulaması olduğunu belirtir. -->
        <meta-data android:name="com.google.android.gms.ads.AD_MANAGER_APP" android:value="true"/>

        <!-- AdMob uygulama ID'sini belirtir. -->
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="@string/admob_app_id"/>

        <!-- Firebase Analytics uygulama ID'sini belirtir. -->
        <!-- <meta-data android:name="com.google.firebase.analytics.APP_ID" android:value="@string/google_app_id"/> -->

        <!-- Google Ad Services yapılandırma dosyasının yolunu belirtir. -->
        <meta-data android:name="com.google.android.gms.ads.AD_SERVICES_CONFIG" android:resource="@xml/gma_ad_services_config" tools:replace="android:resource"/>

        <!-- Measurement API yapılandırma dosyasının yolunu belirtir. -->
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/ga_ad_services_config"
            tools:replace="android:resource" />

        <activity
            android:name=".Giris"
            android:exported="true"
            android:theme="@style/Theme.Giris">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".Formula_List" android:exported="false" android:theme="@style/Theme.Nurullah"/>
        <activity android:name=".Formula_Detail" android:exported="false" />
        <activity android:name=".Ayarlar" android:exported="false" />
        <activity android:name=".PremiumActivity" android:exported="false" android:theme="@style/Theme.Nurullah" />
        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <receiver
            android:name=".FormulaOfDayWidgetProvider"
            android:exported="true"
            android:label="@string/widget_formula_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_formula_of_day_info" />
        </receiver>
        <receiver
            android:name=".StudyReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".StudyReminderScheduler$BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <activity
            android:name="com.google.android.gms.ads.AdActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent"
            tools:replace="android:configChanges" />
    </application>
</manifest>
